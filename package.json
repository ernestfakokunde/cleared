{
  "name": "cleared-monorepo",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": { "dev": "npm run dev --workspace frontend", "build": "npm run build --workspace backend && npm run build --workspace frontend", "start": "npm run start --workspace frontend", "dev:backend": "npm run dev --workspace backend", "start:backend": "npm run start --workspace backend", "db:generate": "npm run db:generate --workspace backend", "db:migrate": "npm run db:migrate --workspace backend", "db:seed": "npm run db:seed --workspace backend" }
}
